# API and task storage
SMARTCROP_ACCESS_CODE=replace-with-a-long-random-code
SMARTCROP_DATA_DIR=./var/smartcrop
SMARTCROP_DATABASE_PATH=./var/smartcrop/smartcrop.sqlite3
SMARTCROP_WEB_DIST=./apps/web/dist

# Shared demo account (not private accounts for multiple visitors).
SMARTCROP_DEMO_USERNAME=demo
SMARTCROP_DEMO_DISPLAY_NAME=演示摄影师
# Local/controlled presentations use demo / 123456 by default.
# Override with a private password before exposing the service publicly.
# Explicitly empty: first API start generates DATA_DIR/demo-credentials.txt.
SMARTCROP_DEMO_PASSWORD=123456
SMARTCROP_SESSION_TTL_SECONDS=604800
# true for public HTTPS; false for local HTTP / SSH forwarding.
SMARTCROP_SESSION_COOKIE_SECURE=false

# Queue and lifecycle
SMARTCROP_QUEUE_LIMIT=5
SMARTCROP_RETENTION_SECONDS=3600
# Retention above affects disposable AI jobs, NOT saved projects or archives.
SMARTCROP_TASK_TIMEOUT_SECONDS=120
SMARTCROP_WORKER_POLL_SECONDS=1
# Max simultaneous full-resolution decode/encode passes (memory bound on uploads).
SMARTCROP_DECODE_CONCURRENCY=2

# Use "mock" for local UI work and "venus" on the GPU host.
SMARTCROP_WORKER_BACKEND=mock
SMARTCROP_MODEL_PATH=/absolute/path/to/Venus/model
SMARTCROP_LOAD_IN_8BIT=true
# Only set true after the real Venus P0 capability suite passes on a GPU host.
SMARTCROP_P0_CAPABILITIES_VERIFIED=false

# Optional report translation; a missing key falls back to the original report.
# Never commit a real API key.
SMARTCROP_REPORT_TRANSLATOR=none
SMARTCROP_DEEPSEEK_API_KEY=
SMARTCROP_DEEPSEEK_BASE_URL=https://api.deepseek.com
SMARTCROP_DEEPSEEK_MODEL=deepseek-v4-flash
# Total translation budget per report, including all retries (not per request).
SMARTCROP_DEEPSEEK_TIMEOUT_SECONDS=12
